{
  "name": "lol-matchmaker-server",
  "version": "1.0.0",
  "description": "Backend server and Discord bot for LoL in-house matchmaking and stats",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "import": "node googleImport.js",
    "import-csv": "node importCsv.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/client": "^5.12.1",
    "cors": "^2.8.5",
    "discord-google-bot": "file:..",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^144.0.0",
    "libsodium-wrappers": "^0.8.4",
    "node-cron": "^4.6.0",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "prism-media": "^1.3.5",
    "socket.io": "^4.7.5",
    "youtube-dl-exec": "^3.1.17"
  },
  "devDependencies": {
    "prisma": "^5.12.1"
  }
