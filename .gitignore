.env
.env.*
!.env.example
*.env
server/.env
client/.env

# 구글 API 인증키 및 서비스 계정 파일
credentials.json
client_secret*.json
service-account*.json
*.pem

# 개인정보 및 데이터 파일
*.csv
*.xlsx
*.xls
members*.csv

# 로컬 데이터베이스
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db
server/prisma/dev.db

